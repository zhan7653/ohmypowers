{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "lang",
    "date",
    "generatedAt",
    "metadata",
    "overview",
    "outcomes",
    "decisions",
    "tasks",
    "projectSections",
    "riskGroups",
    "ideas",
    "appendix"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "status": { "const": "draft" },
    "lang": { "type": "string" },
    "date": { "type": "string" },
    "generatedAt": { "type": "string" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "status", "projectCount", "sessionCount", "title", "lead", "routeSteps"],
      "properties": {
        "date": { "type": "string" },
        "status": { "const": "draft" },
        "projectCount": { "type": "integer" },
        "sessionCount": { "type": "integer" },
        "title": { "type": "string" },
        "lead": { "type": "string" },
        "routeSteps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overview", "readingFocus"],
      "properties": {
        "overview": { "type": "string" },
        "readingFocus": { "type": "string" }
      }
    },
    "outcomes": { "$ref": "#/$defs/titledItems" },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["icon", "title", "body"],
        "properties": {
          "icon": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" }
        }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tomorrowPriority", "backlog"],
      "properties": {
        "tomorrowPriority": { "$ref": "#/$defs/taskItems" },
        "backlog": { "$ref": "#/$defs/taskItems" }
      }
    },
    "projectSections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project", "path", "badge", "results", "pending", "ideas", "evidence"],
        "properties": {
          "project": { "type": "string" },
          "path": { "type": "string" },
          "badge": { "type": "string" },
          "results": { "$ref": "#/$defs/stringItems" },
          "pending": { "$ref": "#/$defs/stringItems" },
          "ideas": { "$ref": "#/$defs/stringItems" },
          "evidence": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "riskGroups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocked", "watch", "limit"],
      "properties": {
        "blocked": { "$ref": "#/$defs/stringItems" },
        "watch": { "$ref": "#/$defs/stringItems" },
        "limit": { "$ref": "#/$defs/stringItems" }
      }
    },
    "ideas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chips"],
      "properties": {
        "chips": { "$ref": "#/$defs/taskItems" }
      }
    },
    "appendix": { "$ref": "#/$defs/evidence" }
  },
  "$defs": {
    "stringItems": { "type": "array", "items": { "type": "string" } },
    "titledItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body"],
        "properties": {
          "title": { "type": "string" },
          "body": { "type": "string" }
        }
      }
    },
    "taskItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "project", "sourceSessionIds"],
        "properties": {
          "text": { "type": "string" },
          "project": { "type": "string" },
          "sourceSessionIds": { "$ref": "#/$defs/stringItems" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionIds", "filesModified"],
      "properties": {
        "sessionIds": { "$ref": "#/$defs/stringItems" },
        "filesModified": { "$ref": "#/$defs/stringItems" }
      }
    }
  }
}
